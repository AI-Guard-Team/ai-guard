# AI-Guard ortam değişkenleri — ÖRNEK DEĞERLER
# Bu dosyayı .env olarak kopyala ve kendi değerlerinle doldur.
# .env dosyası ASLA commit edilmez.

# ----- PostgreSQL -----
POSTGRES_USER=aiguard
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aiguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# .NET bağlantı dizesi (api bunu okur)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=aiguard;Username=aiguard;Password=change_me

# ----- Kimlik doğrulama -----
# En az 32 karakterlik rastgele bir değer
JWT_SECRET=change_me_to_a_long_random_string_32chars_min

# ----- Servisler arası -----
# api -> vision isteklerinde X-Service-Key başlığı
VISION_SERVICE_KEY=change_me
VISION_SERVICE_URL=http://localhost:8000
# vision'ın uvicorn işçi sayısı (Docker Compose); her işçi ~600 MB. 2 işçi 25 adaya kadar yetiyor,
# H3'ün 50 adaylık senaryosunda 4 yapın (docs/benchmark-D1.md)
VISION_WORKERS=2
# vision'da onnxruntime iş parçacığı sayısı (0 = onnxruntime varsayılanı); benchmark'a göre 1
VISION_ORT_THREADS=1

# ----- Kanıt karesi şifreleme -----
# 32 baytlık anahtarın Base64 hâli (AES-256)
EVIDENCE_ENCRYPTION_KEY=change_me_base64_32_bytes

# ----- Örnek veri (yalnızca Development) -----
# Örnek kullanıcıların şifresi, en az 12 karakter (K-06). Docker Compose bunu api'ye geçirir;
# Docker'sız kurulumda user-secrets ile ayarlanır (bkz. README).
Seed__DefaultPassword=change_me_12chars

# ----- E-posta (K-49) -----
# SMTP_HOST boşsa e-posta gönderilmez; davet ve sıfırlama bağlantısı api loguna yazılır (yalnızca geliştirme).
# Doluysa SMTP_FROM zorunlu. SMTP_SECURITY: StartTls (587), Ssl (465) ya da None (yalnızca yerel deneme sunucusu).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AI-Guard <no-reply@kurum.edu.tr>
# E-postadaki bağlantıların başı (önyüzün adresi)
Web__BaseUrl=http://localhost:5173
