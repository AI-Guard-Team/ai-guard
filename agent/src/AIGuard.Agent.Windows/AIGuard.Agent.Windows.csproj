<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Windows 10/11 ajanı. Ortak çekirdeği başlatıyor ve Windows'a özgü cihaz incelemesini
       (WMI, kayıt defteri, süreç listesi, uzak masaüstü oturumu) ekliyor (Y3). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>aiguard-agent</AssemblyName>
    <RootNamespace>AIGuard.Agent.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Win32_ComputerSystem ve Win32_BIOS sorguları; yönetici izni gerektirmiyor. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIGuard.Agent.Core\AIGuard.Agent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yasaklı yazılım listesi ajanın yanına kopyalanıyor; değiştirmek için yeniden derleme gerekmiyor. -->
    <None Update="forbidden-apps.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AIGuard.Agent.Windows.Tests" />
  </ItemGroup>

</Project>
